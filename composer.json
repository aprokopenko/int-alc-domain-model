{
    "name": "alc-os/earning-line-domain-model",
    "description": "Proof of concept domain model for manual adjustments to an earning line",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-pdo_sqlite": "*",
        "ext-pdo": "*",
        "moneyphp/money": "^4.9",
        "php-di/php-di": "^7.1",
        "psr/event-dispatcher": "^1.0",
        "symfony/event-dispatcher": "^8.1",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/boot.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
